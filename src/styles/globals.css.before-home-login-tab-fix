  }

  .premium-modal-body {
    @apply px-6 py-4;
  }

  .premium-modal-footer {
    @apply flex items-center justify-end gap-3 border-t border-slate-100 px-6 py-4;
  }

  /* Premium Avatar */
  .premium-avatar {
    @apply relative flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-full bg-slate-100 text-sm font-semibold text-slate-600;
  }

  .premium-avatar-image {
    @apply h-full w-full object-cover;
  }

  .premium-avatar-placeholder {
    @apply flex h-full w-full items-center justify-center bg-gradient-to-br from-slate-100 to-slate-200 text-slate-500;
  }

  /* Premium Progress */
  .premium-progress-track {
    @apply h-2 overflow-hidden rounded-full bg-slate-100;
  }

  .premium-progress-fill {
    @apply h-full rounded-full bg-gradient-to-r from-emerald-500 to-emerald-400 transition-all duration-500;
  }

  /* Premium Divider */
  .premium-divider {
    @apply border-t border-slate-200;
  }

  .premium-divider-with-text {
    @apply relative flex items-center gap-4;
    @apply before:flex-1 before:border-t before:border-slate-200;
    @apply after:flex-1 after:border-t after:border-slate-200;
  }

  /* Premium Tooltip */
  .premium-tooltip {
    @apply z-50 overflow-hidden rounded-xl border border-slate-200/80 bg-slate-900 px-3 py-2 text-xs font-medium text-white shadow-lg;
  }

  /* Premium Dropdown */
  .premium-dropdown {
    @apply z-50 min-w-[8rem] overflow-hidden rounded-xl border border-slate-200 bg-white p-1 shadow-lg;
  }

  .premium-dropdown-item {
    @apply flex cursor-pointer select-none items-center gap-2 rounded-lg px-3 py-2 text-sm text-slate-700 outline-none;
    @apply hover:bg-slate-100 hover:text-slate-900;
    @apply focus:bg-slate-100 focus:text-slate-900;
  }

  .premium-dropdown-item-active {
    @apply bg-slate-100 text-slate-900;
  }

  /* Premium Search */
  .premium-search {
    @apply relative;
  }

  .premium-search-icon {
    @apply pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 h-5 w-5 text-slate-400;
  }

  .premium-search-input {
    @apply flex h-11 w-full rounded-xl border border-slate-200 bg-white pl-10 pr-4 py-2 text-sm text-slate-900 shadow-sm transition-all;
    @apply placeholder:text-slate-400;
    @apply focus:border-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-200/50;
    @apply disabled:cursor-not-allowed disabled:opacity-50;
  }

  /* Premium Sidebar Nav */
  .premium-sidebar {
    @apply flex h-full w-64 flex-col border-r border-slate-200/80 bg-white;
  }

  .premium-sidebar-header {
    @apply flex h-16 items-center gap-3 border-b border-slate-200/80 px-4;
  }

  .premium-sidebar-nav {
    @apply flex-1 overflow-y-auto p-4;
  }

  .premium-sidebar-section {
    @apply mb-6;
  }

  .premium-sidebar-section-title {
    @apply mb-2 px-3 text-xs font-semibold uppercase tracking-wider text-slate-400;
  }

  .premium-sidebar-item {
    @apply flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 transition-all;
    @apply hover:bg-slate-100 hover:text-slate-900;
  }

  .premium-sidebar-item-active {
    @apply bg-slate-900 text-white;
    @apply hover:bg-slate-800 hover:text-white;
  }

  /* Premium Toolbar */
  .premium-toolbar {
    @apply flex flex-col gap-3 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm;
    @apply sm:flex-row sm:items-center sm:justify-between;
  }

  /* Premium Breadcrumb */
  .premium-breadcrumb {
    @apply flex items-center gap-2 text-sm text-slate-500;
  }

  .premium-breadcrumb-item {
    @apply transition-colors hover:text-slate-700;
  }

  .premium-breadcrumb-separator {
    @apply text-slate-300;
  }

  /* Premium List */
  .premium-list {
    @apply divide-y divide-slate-100;
  }

  .premium-list-item {
    @apply flex items-center gap-4 p-4 transition-colors;
    @apply hover:bg-slate-50/50;
  }

  /* Premium Alert */
  .premium-alert {
    @apply flex items-start gap-3 rounded-xl p-4;
  }

  .premium-alert-info {
    @apply border border-blue-200 bg-blue-50 text-blue-700;
  }

  .premium-alert-success {
    @apply border border-emerald-200 bg-emerald-50 text-emerald-700;
  }

  .premium-alert-warning {
    @apply border border-amber-200 bg-amber-50 text-amber-700;
  }

  .premium-alert-error {
    @apply border border-red-200 bg-red-50 text-red-700;
  }

  /* Premium Switch */
  .premium-switch {
    @apply h-6 w-11 shrink-0 cursor-pointer rounded-full bg-slate-200 transition-colors;
    @apply focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-500 focus-visible:ring-offset-2;
    @apply data-[state=checked]:bg-emerald-600;
  }

  .premium-switch-thumb {
    @apply pointer-events-none block h-5 w-5 rounded-full bg-white shadow-lg ring-0 transition-transform;
    @apply translate-x-0.5;
    @apply group-data-[state=checked]:translate-x-[22px];
  }

  /* Premium Accordion */
  .premium-accordion-trigger {
    @apply flex flex-1 items-center justify-between rounded-xl px-4 py-3 text-sm font-medium text-slate-700;
    @apply hover:bg-slate-50;
    @apply focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-500;
  }

  .premium-accordion-content {
    @apply overflow-hidden text-sm text-slate-600;
  }

  /* Premium Tabs */
  .premium-tabs-list {
    @apply inline-flex h-10 items-center justify-center rounded-xl border border-slate-200 bg-white p-1 shadow-sm;
  }

  .premium-tabs-trigger {
    @apply inline-flex items-center justify-center whitespace-nowrap rounded-lg px-4 py-2 text-sm font-medium text-slate-600 transition-all;
    @apply hover:bg-slate-50 hover:text-slate-900;
    @apply focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-500;
    @apply disabled:pointer-events-none disabled:opacity-50;
  }

  .premium-tabs-trigger-active {
    @apply bg-slate-900 text-white;
    @apply hover:bg-slate-800 hover:text-white;
  }
}

/* Responsive utilities for premium components */
@media (max-width: 640px) {
  .premium-page-header {
    @apply rounded-xl p-4;
  }

  .premium-card {
    @apply rounded-xl;
  }

  .premium-btn {
    @apply w-full justify-center;
  }
}

/* Animation utilities */
@keyframes premium-fade-in {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes premium-scale-in {
  from {
    opacity: 0;
    transform: scale(0.95);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.premium-animate-fade-in {
  animation: premium-fade-in 0.2s ease-out;
}

.premium-animate-scale-in {
  animation: premium-scale-in 0.2s ease-out;
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  .premium-btn,
  .premium-card,
  .premium-card-interactive,
  .premium-action-card,
  .premium-stat-card,
  .premium-progress-fill {
    transition: none !important;
  }

  .premium-skeleton {
    animation: none !important;
  }
}
