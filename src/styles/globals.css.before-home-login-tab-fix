/* HireVify scroll reveal animations START */
.hv-reveal {
  opacity: 0;
  transform: translateY(22px);
  transition:
    opacity 700ms ease,
    transform 700ms ease;
  transition-delay: calc(var(--hv-delay, 0) * 90ms);
  will-change: opacity, transform;
}

.hv-reveal.hv-revealed {
  opacity: 1;
  transform: translateY(0);
}

@keyframes hirevify-soft-float {
  0%, 100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-10px);
  }
}

.hv-float {
  animation: hirevify-soft-float 7s ease-in-out infinite;
}

@media (prefers-reduced-motion: reduce) {
  .hv-reveal {
    opacity: 1 !important;
    transform: none !important;
    transition: none !important;
  }

  .hv-float {
    animation: none !important;
  }
}
/* HireVify scroll reveal animations END */

