

@custom-variant dark (&:is(.dark *));

:root {
  /* Typography Scale - 8pt base grid system */
  --font-family-primary: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-size-xs: 0.75rem;    /* 12px */
  --font-size-sm: 0.875rem;   /* 14px */
  --font-size-base: 1rem;     /* 16px */
  --font-size-lg: 1.125rem;   /* 18px */
  --font-size-xl: 1.25rem;    /* 20px */
  --font-size-2xl: 1.5rem;    /* 24px */
  --font-size-3xl: 1.875rem;  /* 30px */
  --font-size-4xl: 2.25rem;   /* 36px */
  --font-size-5xl: 3rem;      /* 48px */

  /* Font Weights */
  --font-weight-normal: 400;
  --font-weight-medium: 500;
  --font-weight-semibold: 600;
  --font-weight-bold: 700;

  /* App spacing scale - 8pt grid system. Keep this separate from Tailwind's --spacing tokens. */
  --app-spacing-0: 0rem;
  --app-spacing-1: 0.5rem;    /* 8px */
  --app-spacing-2: 1rem;      /* 16px */
  --app-spacing-3: 1.5rem;    /* 24px */
  --app-spacing-4: 2rem;      /* 32px */
  --app-spacing-5: 2.5rem;    /* 40px */
  --app-spacing-6: 3rem;      /* 48px */
  --app-spacing-8: 4rem;      /* 64px */
  --app-spacing-10: 5rem;     /* 80px */
  --app-spacing-12: 6rem;     /* 96px */
  --app-spacing-16: 8rem;     /* 128px */

  /* Professional Color Palette */
  /* Primary - Professional Blue-Green (matching HireVify logo) */
  --primary-50: #f0fdfa;
  --primary-100: #ccfbf1;
  --primary-200: #99f6e4;
  --primary-300: #5eead4;
  --primary-400: #2dd4bf;
  --primary-500: #14b8a6;  /* Main primary */
  --primary-600: #0d9488;  /* Darker primary for hover states */
  --primary-700: #0f766e;
  --primary-800: #115e59;
  --primary-900: #134e4a;
  --primary-950: #042f2e;

  /* Secondary - Professional Navy */
  --secondary-50: #f8fafc;
  --secondary-100: #f1f5f9;
  --secondary-200: #e2e8f0;
  --secondary-300: #cbd5e1;
  --secondary-400: #94a3b8;
  --secondary-500: #64748b;
  --secondary-600: #475569;
  --secondary-700: #334155;  /* Main secondary */
  --secondary-800: #1e293b;
  --secondary-900: #0f172a;
  --secondary-950: #020617;

  /* Semantic Colors */
  --success-50: #f0fdf4;
  --success-100: #dcfce7;
  --success-200: #bbf7d0;
  --success-300: #86efac;
  --success-400: #4ade80;
  --success-500: #22c55e;   /* Main success */
  --success-600: #16a34a;
  --success-700: #15803d;
  --success-800: #166534;
  --success-900: #14532d;

  --warning-50: #fffbeb;
  --warning-100: #fef3c7;
  --warning-200: #fde68a;
  --warning-300: #fcd34d;
  --warning-400: #fbbf24;
  --warning-500: #f59e0b;   /* Main warning */
  --warning-600: #d97706;
  --warning-700: #b45309;
  --warning-800: #92400e;
  --warning-900: #78350f;

  --error-50: #fef2f2;
  --error-100: #fee2e2;
  --error-200: #fecaca;
  --error-300: #fca5a5;
  --error-400: #f87171;
  --error-500: #ef4444;     /* Main error */
  --error-600: #dc2626;
  --error-700: #b91c1c;
  --error-800: #991b1b;
  --error-900: #7f1d1d;

  /* Neutral Grays */
  --gray-50: #fafafa;
  --gray-100: #f5f5f5;
  --gray-200: #e5e5e5;
  --gray-300: #d4d4d4;
  --gray-400: #a3a3a3;
  --gray-500: #737373;
  --gray-600: #525252;
  --gray-700: #404040;
  --gray-800: #262626;
  --gray-900: #171717;
  --gray-950: #0a0a0a;

  /* Design Tokens - Light Mode */
  --background: #ffffff;
  --foreground: var(--gray-900);
  --card: #ffffff;
  --card-foreground: var(--gray-900);
  --popover: #ffffff;
  --popover-foreground: var(--gray-900);
  
  --primary: var(--primary-500);
  --primary-foreground: #ffffff;
  --primary-hover: var(--primary-600);
  
  --secondary: var(--secondary-100);
  --secondary-foreground: var(--secondary-700);
  --secondary-hover: var(--secondary-200);
  
  --muted: var(--gray-100);
  --muted-foreground: var(--gray-600);
  
  --accent: var(--primary-50);
  --accent-foreground: var(--primary-700);
  
  --destructive: var(--error-500);
  --destructive-foreground: #ffffff;
  
  --border: var(--gray-200);
  --input: var(--gray-100);
  --input-background: var(--gray-50);
  --ring: var(--primary-500);

  /* Component Specific Tokens */
  --button-radius: 0.5rem;
  --card-radius: 0.5rem;
  --input-radius: 0.5rem;
  --badge-radius: 0.375rem;

  /* Shadows */
  --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
  --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
  --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);

  /* Accessibility */
  --focus-ring: 0 0 0 2px var(--primary-500);
  --focus-ring-offset: 0 0 0 2px var(--background);
}

.dark {
  --background: var(--gray-950);
  --foreground: var(--gray-50);
  --card: var(--gray-900);
  --card-foreground: var(--gray-50);
  --popover: var(--gray-900);
  --popover-foreground: var(--gray-50);
  
  --primary: var(--primary-400);
  --primary-foreground: var(--gray-900);
  --primary-hover: var(--primary-300);
  
  --secondary: var(--gray-800);
  --secondary-foreground: var(--gray-200);
  --secondary-hover: var(--gray-700);
  
  --muted: var(--gray-800);
  --muted-foreground: var(--gray-400);
  
  --accent: var(--gray-800);
  --accent-foreground: var(--gray-200);
  
  --destructive: var(--error-400);
  --destructive-foreground: var(--gray-900);
  
  --border: var(--gray-800);
  --input: var(--gray-800);
  --input-background: var(--gray-900);
  --ring: var(--primary-400);
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-primary-hover: var(--primary-hover);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-secondary-hover: var(--secondary-hover);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-input-background: var(--input-background);
  --color-ring: var(--ring);
  
  /* Component radii */
  --radius-sm: calc(var(--button-radius) - 2px);
  --radius-md: var(--button-radius);
  --radius-lg: var(--card-radius);
  --radius-xl: calc(var(--card-radius) + 4px);
  
  /* Success colors */
  --color-success: var(--success-500);
  --color-success-foreground: #ffffff;
  --color-success-background: var(--success-50);
  
  /* Warning colors */
  --color-warning: var(--warning-500);
  --color-warning-foreground: #ffffff;
  --color-warning-background: var(--warning-50);
  
  /* Error colors */
  --color-error: var(--error-500);
  --color-error-foreground: #ffffff;
  --color-error-background: var(--error-50);
}

@layer base {
  * {
    @apply border-border;
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-family-primary);
    font-size: var(--font-size-base);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    scroll-padding-top: 88px;
  }

  body {
    @apply bg-background text-foreground;
    font-family: var(--font-family-primary);
    overflow-x: hidden;
  }

  img,
  video,
  canvas,
  svg {
    max-width: 100%;
  }

  button,
  input,
  textarea,
  select {
    letter-spacing: 0;
  }

  input,
  textarea,
  select {
    min-width: 0;
  }

  /* Focus styles for accessibility */
  *:focus {
    outline: none;
  }

  *:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  /* Ensure proper contrast for links */
  a {
    color: var(--primary);
    text-decoration: none;
  }

  a:hover {
    color: var(--primary-hover);
    text-decoration: underline;
  }
}

/**
 * Professional Typography Scale - follows 8pt grid system
 */
@layer base {
  :where(:not(:has([class*=" text-"]), :not(:has([class^="text-"])))) {
    h1 {
      font-size: var(--font-size-4xl);
      font-weight: var(--font-weight-bold);
      line-height: 1.2;
      letter-spacing: 0;
      margin-bottom: var(--app-spacing-3);
    }

    h2 {
      font-size: var(--font-size-3xl);
      font-weight: var(--font-weight-semibold);
      line-height: 1.25;
      letter-spacing: 0;
      margin-bottom: var(--app-spacing-3);
    }

    h3 {
      font-size: var(--font-size-2xl);
      font-weight: var(--font-weight-semibold);
      line-height: 1.3;
      margin-bottom: var(--app-spacing-2);
    }

    h4 {
      font-size: var(--font-size-xl);
      font-weight: var(--font-weight-medium);
      line-height: 1.4;
      margin-bottom: var(--app-spacing-2);
    }

    h5 {
      font-size: var(--font-size-lg);
      font-weight: var(--font-weight-medium);
      line-height: 1.4;
      margin-bottom: var(--app-spacing-2);
    }

    h6 {
      font-size: var(--font-size-base);
      font-weight: var(--font-weight-medium);
      line-height: 1.5;
      margin-bottom: var(--app-spacing-1);
    }

    p {
      font-size: var(--font-size-base);
      font-weight: var(--font-weight-normal);
      line-height: 1.6;
      margin-bottom: var(--app-spacing-2);
    }

    label {
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-medium);
      line-height: 1.5;
      color: var(--foreground);
    }

    button {
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-medium);
      line-height: 1.5;
    }

    input, textarea, select {
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-normal);
      line-height: 1.5;
      font-family: var(--font-family-primary);
    }

    /* Small text utilities */
    .text-caption {
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-normal);
      line-height: 1.4;
      color: var(--muted-foreground);
    }

    .text-overline {
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-medium);
      line-height: 1.4;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--muted-foreground);
    }
  }
}

/* Status color utilities for components */
@layer utilities {
  .text-balance {
    text-wrap: balance;
  }

  .text-pretty {
    text-wrap: pretty;
  }

  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }

  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .status-applied {
    background-color: #dbeafe; color: #1e40af; border-color: #bfdbfe;
  }
  
  .status-screening {
    background-color: #fef3c7; color: #92400e; border-color: #fde68a;
  }
  
  .status-interview {
    background-color:#f3e8ff; color:#6b21a8; border-color:#e9d5ff;
  }
  
  .status-offer {
    background-color:#dcfce7; color:#166534; border-color:#bbf7d0;
  }
  
  .status-rejected {
    background-color:#fee2e2; color:#991b1b; border-color:#fecaca;
  }
  
  .status-hired {
    background-color:#d1fae5; color:#065f46; border-color:#a7f3d0;
  }

  /* Match score color utilities */
  .match-excellent {
    @apply text-green-600;
  }
  
  .match-good {
    @apply text-yellow-600;
  }
  
  .match-fair {
    @apply text-orange-600;
  }
  
  .match-poor {
    @apply text-red-600;
  }

  /* Professional spacing utilities following 8pt grid */
  .space-professional-xs { gap: var(--app-spacing-1); }
  .space-professional-sm { gap: var(--app-spacing-2); }
  .space-professional-md { gap: var(--app-spacing-3); }
  .space-professional-lg { gap: var(--app-spacing-4); }
  .space-professional-xl { gap: var(--app-spacing-6); }

  /* Card elevation utilities */
  .card-elevation-sm {
    box-shadow: var(--shadow-sm);
  }
  
  .card-elevation-md {
    box-shadow: var(--shadow);
  }
  
  .card-elevation-lg {
    box-shadow: var(--shadow-md);
  }
  
  .card-elevation-xl {
    box-shadow: var(--shadow-lg);
  }
}

/* Component-specific professional styling */
@layer components {
  .hv-page-shell {
    @apply min-h-screen bg-[linear-gradient(135deg,#f8fafc_0%,#f1f5f9_42%,#ecfdf5_100%)];
  }

  .hv-container {
    @apply mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8;
  }

  .hv-surface {
    @apply rounded-lg border border-slate-200/80 bg-white/95 shadow-sm shadow-slate-950/5;
  }

  .hv-action-card {
    @apply rounded-lg border border-slate-200 bg-white p-5 text-left shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-emerald-200 hover:bg-emerald-50/40 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2;
  }

  .hv-dashboard-header {
    @apply sticky top-0 z-40 border-b border-slate-200/80 bg-white/90 shadow-sm backdrop-blur-xl;
  }

  .hv-pill {
    @apply inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700;
  }

  [data-slot="card"] {
    @apply border-slate-200/80 shadow-sm shadow-slate-950/5;
  }

  [data-slot="card-title"] {
    @apply tracking-normal text-slate-950;
  }

  [data-slot="card-description"] {
    @apply leading-6 text-slate-600;
  }

  .btn-primary {
    @apply bg-primary text-primary-foreground hover:bg-primary-hover;
    @apply px-4 py-2 rounded-md font-medium text-sm;
    @apply transition-colors duration-200;
    @apply focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2;
  }

  .btn-secondary {
    @apply bg-secondary text-secondary-foreground hover:bg-secondary-hover;
    @apply px-4 py-2 rounded-md font-medium text-sm border border-border;
    @apply transition-colors duration-200;
    @apply focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2;
  }

  .input-field {
    @apply w-full px-3 py-2 bg-input-background border border-border rounded-md;
    @apply text-foreground placeholder:text-muted-foreground;
    @apply focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent;
    @apply transition-all duration-200;
  }

  .card-professional {
    @apply bg-card border border-border rounded-lg p-6;
    @apply shadow-sm hover:shadow-md transition-shadow duration-200;
  }

  .status-badge {
    @apply inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium;
    @apply border;
  }
}

