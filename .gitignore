# See https://help.github.com/articles/ignoring-files/

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
.next/
out/
build/
dist/

# production / generated
.vercel/
.turbo/
.swc/
.cache/
coverage/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# environment variables - never commit secrets
.env
.env.*
!.env.example
!.env*.example

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*

# debug / temporary text files
*-debug.txt
*debug*.txt
ai-resume-debug.txt
build-errors.txt
assignment.status

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# editor / IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# certificates / keys
*.pem
*.key
*.crt
*.p12

# backup files
backups/
backup-*/
encoding-cleanup-backup-*/
*.bak
*.backup
*.backup-*
*.old
*.orig
*~
*.before-*
*.tsx.bak
*.ts.bak
*.css.bak
*.js.bak
*.jsx.bak
next.config.backup.ts

# temporary files
tmp/
temp/
.tmp/
.temp/

# local uploads / generated files
uploads/
public/uploads/

# archive / exported files
*.zip
*.tar
*.tar.gz
*.rar
pro-upgrade-context.txt
